# Токен бота от @BotFather (можно назвать переменную BOT_TOKEN или BOT_API)
BOT_TOKEN=

# Кому присылать новости: Telegram ID через запятую.
# Если пусто — владельцем станет первый, кто нажмёт /start, остальным бот будет закрыт.
ADMIN_IDS=

# Часовой пояс для времени в сообщениях и утреннего анонса (Europe/Moscow, Asia/Almaty …).
# Если пусто — берётся часовой пояс компьютера.
TIMEZONE=

# Во сколько присылать анонс матчей дня (ЧЧ:ММ)
DIGEST_TIME=09:00

# Как часто проверять RSS (секунды, 60–3600)
NEWS_INTERVAL_SEC=180

# Как часто проверять счёт идущих матчей (секунды, 60–3600)
MATCHES_INTERVAL_SEC=300

# Новости старше этого (в часах) не присылаются — защита от лавины после простоя
MAX_NEWS_AGE_HOURS=3

# Если провайдер блокирует Telegram: прокси только для запросов к Telegram
# (http://, https://, socks4://, socks5://), например socks5://user:pass@1.2.3.4:1080
TELEGRAM_PROXY=

# Свой адрес Bot API (self-hosted telegram-bot-api или обратный прокси). Обычно пусто.
TELEGRAM_API_URL=

# ---- Кнопка «✍️ Сделать пост»: готовый пост для канала пишет бесплатная нейросеть ----
# Ключ Gemini: https://aistudio.google.com → Get API key (бесплатно, без карты)
GEMINI_TOKEN=
# Запасной ключ Groq, если Gemini перегружен или кончился лимит: https://console.groq.com → API Keys
GROQ_TOKEN=
# Модели по порядку (обычно не трогать):
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Подпись в конце каждого поста; \n — перенос строки. Пусто — без подписи.
POST_SIGNATURE=⚽️ FUTERA | Больше, чем просто футбол.
# Название канала в левом верхнем углу карточки с итогом матча. Вместо надписи можно
# положить свой логотип в bot/assets/brand.png (PNG с прозрачным фоном).
CARD_BRAND=FUTERA

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
